<?xml version="1.0" encoding="utf-8"?>
<!--
  FIRE LAUNCHER Prism Light Top Downloading Bar.
  Controls relocated to LEFT, Multi-Color Cyan-Indigo-Pink Progress Engine in CENTER,
  Percentage Badge & Cloud Icon relocated to RIGHT.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:padding="11dp"
        android:elevation="6dp"
        android:background="@drawable/aerix_download_dock_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- LEFT: Relocated Task Expand / Pause / Cancel Controls -->
            <ImageButton
                android:id="@+id/progress_flip_arrow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/aerix_download_control_bg"
                android:src="@drawable/spinner_arrow"
                android:tint="#4F46E5"
                android:padding="12dp"
                android:contentDescription="@string/dock_show_tasks" />

            <ImageButton
                android:id="@+id/dock_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/aerix_download_control_bg"
                android:src="@android:drawable/ic_media_pause"
                android:tint="#4F46E5"
                android:padding="10dp"
                android:contentDescription="@string/dock_pause"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/dock_cancel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/aerix_download_control_bg"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#E11D48"
                android:padding="10dp"
                android:contentDescription="@string/dock_cancel"
                android:visibility="gone" />

            <!-- CENTER: FIRE LAUNCHER Brand Tag + Task Name + Multi-Color Progress Bar + Speed/ETA -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FIRE DOWNLOADER · "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="#6366F1" />

                    <TextView
                        android:id="@+id/dock_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/dock_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="5dp"
                    android:max="100"
                    android:progressDrawable="@drawable/aerix_download_progress"
                    android:indeterminateTint="#6366F1" />

                <LinearLayout
                    android:id="@+id/dock_metadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/dock_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11.5sp"
                        android:textColor="#475569"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/dock_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#0284C7" />

                    <TextView
                        android:id="@+id/dock_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#475569" />
                </LinearLayout>
            </LinearLayout>

            <!-- RIGHT: Bold Percentage Readout + Cloud Download Badge -->
            <TextView
                android:id="@+id/dock_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="#DB2777"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/dock_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:background="@drawable/aerix_download_control_bg"
                android:src="@drawable/aerix_ic_cloud_download"
                android:tint="#6366F1"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/dock_task_scroll"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/progress_linear_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</merge>
